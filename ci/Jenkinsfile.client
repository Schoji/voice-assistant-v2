pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    triggers {
        pollSCM('* * * * *')
    }

    environment {
        // Not under /home/schoji: that directory is mode 700, the jenkins user
        // cannot even traverse into it.
        TARGET = '/srv/aleksy'
        PATH = "/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Sync') {
            steps {
                sh '''
                    mkdir -p "$TARGET"
                    rsync -a --delete client/ "$TARGET/client/"
                    rsync -a --delete shared/ "$TARGET/shared/"
                '''
            }
        }

        stage('Install') {
            steps {
                sh 'cd "$TARGET/client" && uv sync --frozen'
            }
        }

        stage('Restart') {
            steps {
                sh 'sudo systemctl restart aleksy-client'
            }
        }
    }
}
