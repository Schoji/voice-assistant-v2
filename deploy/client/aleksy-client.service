[Unit]
Description=Aleksy voice client (wakeword, VAD, transport)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
# schoji, not jenkins: /dev/snd is root:audio and only schoji is in that group.
# Jenkins builds the venv, this service only reads it.
User=schoji
WorkingDirectory=/srv/aleksy/client
ExecStart=/srv/aleksy/client/.venv/bin/python main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
